# =========================================================================
# CẤU HÌNH HỆ THỐNG GIẢI ĐỀ THI AI & NGÂN HÀNG CÂU HỎI
# (Chỉnh sửa tại đây và chạy CHAY_THI.bat để áp dụng ngay)
# =========================================================================

# 1. BẬT / TẮT SUY LUẬN SÂU (REASONING)
# true: Bật reasoning để AI suy luận kỹ lưỡng từng bước trước khi chọn đáp án, chống bẫy đề thi
# false: Tắt reasoning (chỉ dùng suy luận cơ bản để phản hồi nhanh nhất)
ENABLE_REASONING=true

# Mức độ suy luận: high (suy luận sâu nhất), medium (cân bằng), low (nhẹ)
REASONING_EFFORT=high

# 2. BẬT / TẮT LƯU & TÁI SỬ DỤNG CACHE SUPABASE
# true: Tự động tra cứu ngân hàng câu hỏi Supabase trước (0ms) và tự lưu câu hỏi mới giải
# false: Tắt hoàn toàn cache, giải 100% bằng AI mới hoàn toàn
ENABLE_SUPABASE_CACHE=false
ENABLE_SCREENSHOT_UPLOAD=true
SCREENSHOT_UPLOAD_BUCKET=screenshots
SCREENSHOT_UPLOAD_MAX_BYTES=6000000

# Cấu hình kết nối Supabase
SUPABASE_URL=https://aacpvpfkqhwlltwjjiag.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFhY3B2cGZrcWh3bGx0d2pqaWFnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwMzU4MTMsImV4cCI6MjEwNDYxMTgxM30.RUNkB2a4_Ji2rAHbqbBOMmmDDo_j8hDl7dmXKj1IooM

# 3. MÔ HÌNH AI ĐỐI CHIẾU (CONSENSUS)
DEFAULT_MODEL=claude-opus-4-8
CONSENSUS_MODEL=gemini-3.5-flash
DETECT_MODEL=gemini-3.5-flash
