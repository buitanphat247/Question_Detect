# Copy this file to .env and set credentials in the local file only.
ENABLE_REASONING=true
REASONING_EFFORT=high
ENABLE_SUPABASE_CACHE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

ENABLE_SCREENSHOT_UPLOAD=false
SCREENSHOT_UPLOAD_BUCKET=screenshots
SCREENSHOT_UPLOAD_MAX_BYTES=6000000

DEFAULT_MODEL=gemini-3.7-flash
CONSENSUS_MODEL=gemini-3.7-flash
DETECT_MODEL=gemini-3.7-flash
KEY4U_API_KEY=your-api-key
